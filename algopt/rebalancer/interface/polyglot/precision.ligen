cpp_include "algopt/rebalancer/algopt_common/Precision.h";
namespace "facebook::algopt";

// Float comparisons using the default precision tolerances.
class Precision {
  // Returns -1, 0 or 1 when value1 is less than, within tolerance of, or
  // greater than value2.
  static i32 compare(double value1, double value2) throws;
}
